# Автоматическая нормализация переводов строк (CRLF в рабочей копии, LF в репозитории)
* text=auto

# Вендорный ZstdSharp использует LF — фиксируем как есть, чтобы git не переписывал их при каждом чекауте
ZstdSharp/** text eol=lf

# Бинарные артефакты (если когда-нибудь попадут в историю)
*.png binary
*.zip binary
*.dll binary
*.exe binary
*.wcx64 binary
*.snk binary
