<?xml version="1.0" encoding="utf-8"?>
<!--
  Профиль «компактная папка»: ..\publish\framework-dependent\ (~0,7 МБ, 6 файлов).
  Container_V3.exe + Container_V3.dll + ZstdSharp.dll + System.IO.Hashing.dll
  + deps.json/runtimeconfig.json. Всю папку копируете целиком.
  Требует установленного .NET Runtime 10 (Microsoft.NETCore.App 10.x) на целевом ПК.

  Использование:
    dotnet publish Container_V3\Container_V3.csproj -c Release -p:PublishProfile=framework-dependent
    .\publish.ps1 -Profile framework-dependent
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows</TargetFramework>

    <SelfContained>false</SelfContained>

    <!-- папка результата: <корень репозитория>\publish\framework-dependent -->
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\publish\framework-dependent\</PublishDir>
  </PropertyGroup>
</Project>
