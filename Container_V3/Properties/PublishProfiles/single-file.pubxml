<?xml version="1.0" encoding="utf-8"?>
<!--
  Профиль «один файл»: ..\publish\single-file\Container_V3.exe (~36 МБ).
  Внутри exe лежит .NET рантайм и все зависимости (System.IO.Hashing, ZstdSharp).
  На целевом компьютере ставить ничего не нужно — скопируйте один файл и запускайте.

  Использование:
    dotnet publish Container_V3\Container_V3.csproj -c Release -p:PublishProfile=single-file
    .\publish.ps1 -Profile single-file -Runtime win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows</TargetFramework>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- нативных библиотек в проекте нет (ZstdSharp — чистый C#), поэтому распаковка не нужна -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- сжатие содержимого однофайлового exe: ~40 МБ -> ~36 МБ -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- папка результата: <корень репозитория>\publish\single-file -->
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\publish\single-file\</PublishDir>
  </PropertyGroup>
</Project>
