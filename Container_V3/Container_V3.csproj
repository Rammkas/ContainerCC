<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Container_V3</RootNamespace>
    <AssemblyName>Container_V3</AssemblyName>

    <!-- Общие настройки публикации. Профили (self-contained / компактная папка) лежат в
         Properties\PublishProfiles\*.pubxml и подключаются самим SDK:
         dotnet publish -c Release -p:PublishProfile=single-file
         Удобнее запускать .\publish.ps1 (см. PUBLISH.md). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Формат и вся логика контейнера переехали в Container.Core (net10.0, без зависимости от Windows).
         Здесь остались только разбор аргументов, вывод в консоль, selftest и pack-bench.
         System.IO.Hashing и ZstdSharp приходят через Container.Core транзитивно. -->
    <ProjectReference Include="..\Container.Core\Container.Core.csproj" />
  </ItemGroup>

  <!-- В папку публикации не кладём .pdb (символы чужих проектов всё равно копируются) -->
  <Target Name="RemovePdbsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
