<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- requestLegacyExternalStorage: на Android 10 даёт обычный доступ к общей памяти,
       как на 7–9, пока приложение не переведено на scoped storage. -->
  <application android:allowBackup="true" android:icon="@mipmap/appicon" android:label="@string/app_name" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:requestLegacyExternalStorage="true">
  </application>

  <!-- Android 11+: «Доступ ко всем файлам». Без него контейнеры нельзя держать в общих
       папках — там же, где их видит Total Commander для Android. -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

  <!-- Android 7..10: обычный доступ к общей памяти, выдаётся пользователем при запуске. -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
</manifest>
