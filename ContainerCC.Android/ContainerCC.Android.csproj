<Project Sdk="Microsoft.NET.Sdk">

  <!-- ContainerCC для Android: те же контейнеры .cc, что читает и пишет WCX-плагин для
       Total Commander, но прямо на телефоне — просмотр, извлечение, добавление, удаление
       по маске, уплотнение и проверка целостности. ПК в рабочей схеме не участвует:
       контейнер лежит в общей памяти телефона и меняется на месте.
       Логика формата не переписана: приложение ссылается на Container.Core — то же ядро,
       из которого собраны CLI и плагин. -->
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <!-- Android 7.0 — нижняя граница .NET for Android. Разрешение «все файлы» существует
         только с Android 11; код смотрит на Build.VERSION.SdkInt. -->
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.containercc</ApplicationId>
    <!-- Генерируемый Resource кладется в ContainerCC.Mobile, а не в ContainerCC.Android:
         имя с «.Android» на конце ломает ссылки на Android.OS.* и Android.Resource.* внутри кода. -->
    <RootNamespace>ContainerCC.Mobile</RootNamespace>
    <AndroidResgenNamespace>ContainerCC.Mobile</AndroidResgenNamespace>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <TrimMode>full</TrimMode>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Container.Core\Container.Core.csproj" />
  </ItemGroup>

</Project>
